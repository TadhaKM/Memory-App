# =============================================================================
# Recall App - Local Properties Template
# =============================================================================
# Copy this file to local.properties and fill in your actual API keys.
# IMPORTANT: local.properties is gitignored and should NEVER be committed.
#
# You can also set these as environment variables instead.
# =============================================================================

# Android SDK location (auto-generated by Android Studio)
# sdk.dir=/path/to/android/sdk

# =============================================================================
# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# Anthropic Claude API (for AI features)
# Get your key from: https://console.anthropic.com/
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-your-key-here

# =============================================================================
# PostHog Analytics (optional)
# Get your key from: https://posthog.com/
# =============================================================================
POSTHOG_API_KEY=

# =============================================================================
# Sentry Error Tracking (optional)
# Get your DSN from: https://sentry.io/
# =============================================================================
SENTRY_DSN=
